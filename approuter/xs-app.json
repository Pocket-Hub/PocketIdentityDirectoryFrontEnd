{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "/api/(.*)",
      "target": "/api/$1",
      "destination": "Pocket-Identity-Directory-Backend"
    },
    {
      "source": "^/(.*\\.(html|js|css|map|png|jpg|jpeg|svg|ico|woff2?))$",
      "target": "$1",
      "localDir": "dist",
      "authenticationType": "ias"
    },
    {
      "source": "^(?!.*\\.).*$",
      "target": "/index.html",
      "localDir": "dist",
      "authenticationType": "ias"
    }
  ],
  "logout": {
    "logoutEndpoint": "/do/logout"
  }
}